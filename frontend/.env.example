# SamadhanHub Frontend Environment Variables
# Copy to .env.local for local development
# Set in Vercel dashboard for production deployment

# Backend API URL — set to your deployed backend URL
NEXT_PUBLIC_API_URL=https://samadhanhub-api.onrender.com/api

# Server-side rewrite target (used by next.config.mjs for /api/*).
# For LOCAL dev, create .env.local with: BACKEND_URL=http://localhost:5000
# (start.bat / restart.bat already set this automatically.)
# BACKEND_URL=http://localhost:5000

# Direct AI fallback (serverless/Vercel): when BACKEND_URL is unreachable,
# /api/vision/analyze calls providers itself — set these in the Vercel
# dashboard (Settings → Environment Variables) and redeploy. Not needed
# for local dev (the :5000 bridge handles AI). Never commit real keys.
# XKIRO_API_KEY=
# NVIDIA_API_KEY=
# UNO_API_KEY=
